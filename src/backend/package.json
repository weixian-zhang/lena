{
  "name": "@lena/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Lena — Azure cloud expert agent (backend)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "bin": {
    "lena": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "node --eval \"import('node:fs').then(async ({promises:fs})=>{for await(const f of fs.glob(['src/**/*.md','src/**/*.sql'])){const d='dist'+f.slice(3);await fs.mkdir(d.slice(0,d.lastIndexOf('/')),{recursive:true});await fs.copyFile(f,d);}})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
